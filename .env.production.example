# Production configuration. On the server, copy this to .env.production and
# fill it in. .env.production is gitignored — it holds real secrets and must
# never be committed. Generate every secret FRESH for production; never reuse
# your development values.

# The public hostname. No domain needed: <your-server-ip>.sslip.io resolves
# to your IP, and Let's Encrypt will issue a real certificate for it.
# Example: 129.154.12.34.sslip.io
SITE_ADDRESS=

# Must be the public URL exactly — the API accepts browser requests only from
# here (CORS). Same host as above, with https://.
WEB_ORIGIN=https://

# From the Neon dashboard → Connection string. Keep ?sslmode=require: the
# database is reached over the internet, so the connection must be encrypted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_TTL_SECONDS=604800

# Same generator as JWT_SECRET, a DIFFERENT value.
BOT_SERVICE_SECRET=

# Redis runs on the same server and isn't exposed to the internet, but it
# still gets a password — protection for the day someone publishes its port by
# mistake. Hex only (same generator as above): it goes inside a URL, where
# characters like @ : / would break parsing.
REDIS_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
LINK_CODE_TTL_SECONDS=600

AI_GATEWAY_API_KEY=
AI_MODEL=mistral/ministral-14b
# The chat assistant and negotiation proposals — where the model has to pick
# the right tool or the right change, which the smaller model kept getting
# wrong. A reasoning model: slower and pricier per call, so reminders stay on
# AI_MODEL. Leave unset to use AI_MODEL everywhere.
AI_ASSISTANT_MODEL=openai/gpt-5-mini
AI_EMBEDDING_MODEL=cohere/embed-v4.0
MEMORY_PROVIDER=pgvector

# Deliberately absent: FOLLOWUP_DELAY_MINUTES. That's a testing override that
# forces every follow-up to fire after a minute. In production the delay is
# computed per goal.
