{
  "name": "accountability-coach",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=@coach/api",
    "dev:web": "npm run dev --workspace=@coach/web",
    "dev:bot": "npm run dev --workspace=@coach/bot",
    "dev:worker": "npm run dev:worker --workspace=@coach/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
