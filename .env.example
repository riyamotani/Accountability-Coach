# Copy to .env and fill in. .env is gitignored; this file is committed as the
# canonical list of what the app needs.

PORT=4000

# Postgres connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The default matches the `postgres` service in docker-compose.yml, which is
# exposed on 5433 (not Postgres's usual 5432) to avoid clashing with a
# Postgres installed directly on the machine.
DATABASE_URL=postgresql://coach:coach@localhost:5433/coach
WEB_ORIGIN=http://localhost:3000

# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Anyone holding this can forge a token for ANY user — treat it like a password.
JWT_SECRET=

JWT_TTL_SECONDS=604800

# --- Telegram bot ---

# From @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# The bot's @username WITHOUT the @. Only used to build the t.me deep link
# shown in Settings — not a secret.
TELEGRAM_BOT_USERNAME=

# Shared between the api and bot processes so the API can recognise the bot as
# a trusted first-party service. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guard it exactly like JWT_SECRET — anyone holding it can act as ANY user.
BOT_SERVICE_SECRET=

# How long a Telegram linking code stays valid.
LINK_CODE_TTL_SECONDS=600

# Where the bot finds the API. In Docker Compose this becomes http://api:4000
# (service name), not localhost.
API_URL=http://localhost:4000

# --- Scheduler ---

# Where BullMQ finds Redis. In Docker Compose this becomes redis://redis:6379.
REDIS_URL=redis://127.0.0.1:6379

# TESTING OVERRIDE ONLY. Leave unset for real use — the real follow-up delay
# is computed per goal from its target (roughly double the target time,
# floored at 15min/capped at 3h, falling back to 2h with no usable target).
# Set this to a small number (e.g. 1) while developing so you don't wait
# hours to see the follow-up fire.
FOLLOWUP_DELAY_MINUTES=

# --- AI layer ---

# Vercel AI Gateway: vercel.com -> AI Gateway -> API Keys. Optional: leave
# unset and the worker sends plain templated reminders instead of
# AI-personalized ones — nothing breaks either way.
AI_GATEWAY_API_KEY=

# Gateway model ids are `provider/model` — copy them from the Gateway catalog,
# since spellings can differ from the provider's own API. Check the model is
# available on your plan: the free tier only includes a subset.
AI_MODEL=mistral/ministral-14b
